            "nullable": true
          },
          "googleScholar": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AddPaymentDto": {
        "required": [
          "amount",
          "status"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "minLength": 1,
            "pattern": "Success|Pending|Failed",
            "type": "string"
          },
          "currency": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AddWebsiteDto": {
