        "required": [
          "customerEmail",
          "customerName",
          "customerPass"
        ],
        "type": "object",
        "properties": {
          "customerEmail": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "customerName": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "customerPass": {
            "minLength": 8,
            "type": "string"
          },
          "college": {
            "type": "string",
            "nullable": true
          },
          "major": {
